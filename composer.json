{
    "name": "geeklab/glroute",
    "description": "Yet another PHP Router",
    "type": "library",
    "license": "bsd-3-clause",
    "autoload": {
        "psr-4": {
            "GeekLab\\GLRoute\\": "src/"
        }
    },
    "require": {
        "php": ">=8.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0",
        "phpstan/phpstan": "^2",
        "squizlabs/php_codesniffer": "^3"
    },
    "scripts": {
        "test": "phpunit",
        "phpstan": "phpstan analyse --no-progress",
        "phpcs": "phpcs src --standard=PSR12 -n"
    }
}
